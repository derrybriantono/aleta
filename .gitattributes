# ============================================================================
# AKHIR BARIS
# ============================================================================
#
# Repositori ini dikembangkan di Windows tetapi DIJALANKAN di Linux. Tanpa
# berkas ini, git mengubah akhir baris menjadi CRLF saat checkout di Windows,
# dan berkas itulah yang ikut terpaket installer.
#
# Akibatnya pada skrip shell: baris pertama menjadi "#!/usr/bin/env bash\r",
# dan Linux mencari penerjemah bernama "bash\r" yang tidak ada. Galatnya pun
# menyesatkan - karakter \r memindahkan kursor ke awal baris sehingga pesan
# aslinya tertimpa, dan yang terbaca hanya potongan seperti:
#
#     : nama pilihan tidak valid pipefail
#
# Tidak ada petunjuk sama sekali bahwa masalahnya akhir baris.
# ============================================================================

# Bawaan: biarkan git menormalkan teks, tetapi simpan selalu dengan LF.
* text=auto eol=lf

# Berkas yang DIJALANKAN di Linux - wajib LF, apa pun sistem penyuntingnya.
*.sh          text eol=lf
*.bash        text eol=lf
*.sql         text eol=lf
Dockerfile    text eol=lf
*.Dockerfile  text eol=lf
.dockerignore text eol=lf
*.conf        text eol=lf
*.service     text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf

# Berkas biner - jangan disentuh sama sekali.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.pdf  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.tar.gz binary
