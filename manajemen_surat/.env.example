DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/aleta
BETTER_AUTH_SECRET=aleta-local-dev-secret-change-this
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_PLACES_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=
# WhatsApp runtime mode: aleta_bot (default) | legacy_portal | disabled
WHATSAPP_RUNTIME_MODE=aleta_bot
# URL dasar aleta_bot (ALETA_BOT_BASE_URL diutamakan, ALETA_BOT_RUNTIME_URL sebagai fallback)
ALETA_BOT_BASE_URL=http://127.0.0.1:3003
ALETA_BOT_RUNTIME_URL=http://127.0.0.1:3003
# Token untuk endpoint internal aleta_bot (header: x-aleta-internal-token)
ALETA_BOT_INTERNAL_API_TOKEN=
ALETA_BOT_INTERNAL_TOKEN=
# Timeout request ke gateway aleta_bot dalam ms (default 8000)
ALETA_BOT_GATEWAY_TIMEOUT_MS=8000
# Optional: key enkripsi password manual Sumber Data SQL. Set nilai kuat yang sama di aleta_bot.
ALETA_BOT_DB_SECRET_ENCRYPTION_KEY=
# Auto-sync server-side saat dashboard Super Admin membaca status AI needs_sync.
ALETA_BOT_AI_AUTO_SYNC_ON_DASHBOARD=true
# AI Config Bridge ke runtime aleta_bot. API key tetap dikelola dari UI Pengaturan AI portal.
ALETA_BOT_AI_CONFIG_SOURCE=portal
ALETA_BOT_AI_TIMEOUT_MS=8000
ALETA_BOT_AI_DEFAULT_PROVIDER=gemini
ALETA_BOT_AI_DEFAULT_MODEL=gemini-1.5-flash
ALETA_BOT_DB_SIPP_HOST=localhost
ALETA_BOT_DB_SIPP_PORT=3306
ALETA_BOT_DB_SIPP_NAME=SIPP
ALETA_BOT_DB_SIPP_USER=root
ALETA_BOT_DB_SIPP_PASSWORD=
ALETA_BOT_DB_ANTRIAN_HOST=localhost
ALETA_BOT_DB_ANTRIAN_PORT=3306
ALETA_BOT_DB_ANTRIAN_NAME=sipp_turunan_antrian
ALETA_BOT_DB_ANTRIAN_USER=root
ALETA_BOT_DB_ANTRIAN_PASSWORD=
ALETA_BOT_DB_APS_HOST=localhost
ALETA_BOT_DB_APS_PORT=3306
ALETA_BOT_DB_APS_NAME=aps_badilag
ALETA_BOT_DB_APS_USER=root
ALETA_BOT_DB_APS_PASSWORD=
ALETA_BOT_PUBLIC_QA_AI_ENABLED=false
ALETA_BOT_PUBLIC_QA_OPENAI_MODEL=gpt-4o-mini
ALETA_BOT_PUBLIC_QA_AI_ANSWER_ENABLED=false
ALETA_BOT_PUBLIC_QA_AI_ANSWER_MODE=template_only
ALETA_BOT_PUBLIC_QA_AI_TIMEOUT_MS=8000
ALETA_BOT_PUBLIC_QA_MAX_TOKENS=400
ALETA_BOT_PUBLIC_QA_TEMPERATURE=0.2
ALETA_BOT_PUBLIC_QA_SESSION_TTL_MINUTES=20
ALETA_BOT_PUBLIC_QA_REQUIRE_APPROVAL=true
OPENAI_API_KEY=
