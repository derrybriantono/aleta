NODE_ENV=production
SERVER_IP=192.168.10.10

# URL utama aplikasi
NEXT_PUBLIC_BASE_PATH=/aleta
BETTER_AUTH_URL=http://192.168.10.10/aleta
BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.10.10

# Portal
PORTAL_PORT=3000
ALETA_UPLOAD_DIR=/app/uploads
ALETA_PDF_UPLOAD_DIR=/app/uploads/pdf

# Sistem update ALETA
# Kosongkan jika update dicek dari file lokal /app/reports/aleta-update-latest.json.
ALETA_UPDATE_MANIFEST_URL=

# ALETA Bot
ALETA_BOT_PORT=3003
WHATSAPP_RUNTIME_MODE=aleta_bot
ALETA_BOT_BASE_URL=http://127.0.0.1:3003
ALETA_BOT_WHATSAPP_SESSION_NAME=aleta-whatsapp-main
ALETA_BOT_LEGACY_NOTIFICATION_SCHEDULER_ENABLED=false

# Database eksternal yang dibaca ALETA Bot
ALETA_BOT_DB_HOST=127.0.0.1
ALETA_BOT_DB_PORT=3306
ALETA_BOT_DB_USER=aleta_bot_user
ALETA_BOT_DB_PASSWORD=CHANGE_ME_ALETA_BOT_DB_PASSWORD
ALETA_BOT_DB_NAME=aleta_bot

# Database tambahan opsional untuk integrasi ALETA Bot
ALETA_BOT_DB_SIPP_HOST=127.0.0.1
ALETA_BOT_DB_SIPP_PORT=3306
ALETA_BOT_DB_SIPP_NAME=CHANGE_ME_SIPP_DB
ALETA_BOT_DB_SIPP_USER=sipp_readonly_user
ALETA_BOT_DB_SIPP_PASSWORD=CHANGE_ME_SIPP_PASSWORD
ALETA_BOT_DB_ANTRIAN_HOST=127.0.0.1
ALETA_BOT_DB_ANTRIAN_PORT=3306
ALETA_BOT_DB_ANTRIAN_NAME=CHANGE_ME_ANTRIAN_DB
ALETA_BOT_DB_ANTRIAN_USER=CHANGE_ME_ANTRIAN_USER
ALETA_BOT_DB_ANTRIAN_PASSWORD=CHANGE_ME_ANTRIAN_PASSWORD
ALETA_BOT_DB_APS_HOST=127.0.0.1
ALETA_BOT_DB_APS_PORT=3306
ALETA_BOT_DB_APS_NAME=CHANGE_ME_APS_DB
ALETA_BOT_DB_APS_USER=CHANGE_ME_APS_USER
ALETA_BOT_DB_APS_PASSWORD=CHANGE_ME_APS_PASSWORD

# Dokumen SIPP (petitum_dok/gugatan) yang dilampirkan ke WhatsApp pihak.
# Bot mencoba membaca file lokal dulu, baru jatuh ke HTTP bila tidak ketemu.
#   ROOTS    : folder di DALAM container (lihat mount :ro pada docker-compose.yml).
#   BASE_URL : alamat web SIPP; dengan network_mode host, 127.0.0.1 = host server.
# Uji hasilnya: docker compose exec aleta_bot node scripts/check-sipp-document.js
ALETA_BOT_SIPP_DOCUMENT_ROOTS=/usr/src/app/SIPP,/var/www/html/SIPP
ALETA_BOT_SIPP_DOCUMENT_BASE_URL=http://127.0.0.1/SIPP

# Kode satker pada nomor perkara, dipakai antrian sidang online untuk melengkapi
# input singkat pihak (mis. "123.G.2026" -> "123/Pdt.G/2026/PA.Dgl").
# WAJIB diganti bila dipasang di satker selain PA Donggala.
ALETA_BOT_COURT_CODE=PA.Dgl

# Token internal portal <-> ALETA Bot
# Isi nilai yang sama di portal dan aleta_bot. Jangan bagikan token ini.
ALETA_BOT_INTERNAL_API_TOKEN=CHANGE_ME_RANDOM_INTERNAL_TOKEN
ALETA_BOT_INTERNAL_TOKEN=CHANGE_ME_RANDOM_INTERNAL_TOKEN

# AI Bridge
# Tombol "Sinkronkan AI ke ALETA Bot" akan GAGAL bila AI diaktifkan di portal
# tetapi API key tidak tersedia bagi container aleta_bot. Pilih SALAH SATU cara:
#
#  Cara 1 (disarankan) - simpan key sebagai env, portal tidak mengirim secret:
#     ALETA_BOT_AI_API_KEY_ENV=GEMINI_API_KEY
#     GEMINI_API_KEY=<api key asli Anda>
#
#  Cara 2 - pakai key yang sudah tersimpan di Pengaturan AI portal. Key dikirim
#     lewat jalur internal bertoken antar container, jadi tidak perlu disalin ke
#     berkas ini. Aktifkan dengan:
#     ALETA_BOT_ALLOW_VOLATILE_AI_SECRET=true
#     Catatan: key hanya tersimpan di memori bot, jadi wajib Sinkronkan AI lagi
#     setiap container aleta_bot direstart.
#
# Bila AI memang tidak dipakai, biarkan AI nonaktif di Pengaturan AI portal dan
# tombol sinkronisasi tidak perlu dijalankan.
ALETA_BOT_AI_CONFIG_SOURCE=portal
ALETA_BOT_AI_FALLBACK_ENV_ENABLED=false
ALETA_BOT_AI_API_KEY_ENV=GEMINI_API_KEY
GEMINI_API_KEY=CHANGE_ME_AI_KEY
ALETA_BOT_ALLOW_VOLATILE_AI_SECRET=false

# Database
DATABASE_URL=postgresql://aleta:CHANGE_ME_STRONG_PASSWORD@postgres:5432/aleta
POSTGRES_USER=aleta
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=aleta

# Auth Secret
BETTER_AUTH_SECRET=CHANGE_ME_RANDOM_SECRET

# ==========================================================================
# Jaringan keluar untuk AI (Gemini/ChatGPT/Claude)
# ==========================================================================
# Bila Uji Koneksi AI gagal, jalankan diagnosa dulu:
#   docker compose exec portal node scripts/diagnose-ai-dns.js
#
# --- Bila gagal DNS ("getaddrinfo EAI_AGAIN") -----------------------------
# Secara default container portal MEWARISI DNS host (tidak dipaksa), jadi bila
# DNS host sudah jalan tidak perlu apa-apa. Bila resolusi tetap gagal, isi DNS
# internal kantor. BUAT berkas ".env" DI SAMPING docker-compose.yml (bukan
# berkas ini), isi dengan nilai dari /etc/resolv.conf host, contoh:
#   ALETA_DNS_PRIMARY=192.168.8.1
#   ALETA_DNS_SECONDARY=192.168.1.1
# Lalu: docker compose up -d portal
# Cari nilai yang benar: docker compose exec portal node scripts/diagnose-ai-dns.js
#
# --- Bila kantor mewajibkan proxy keluar ----------------------------------
# Variabel di BAWAH ini boleh diisi di berkas .env.production ini.
# Dikosongkan = ALETA menghubungi penyedia secara langsung.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,aleta_bot,192.168.10.10
# Sertifikat CA kantor bila proxy menyadap TLS (tunjuk berkas .crt).
NODE_EXTRA_CA_CERTS=
