{\header\pard\s17\itap0\widctlpar\ri360\tqc\tx4513\tqr\tx9026\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\plain\f1\fs24     \par}
{\footer\pard\s18\itap0\widctlpar\qr\tqc\tx4513\tqr\tx9026\tx9360\tx10080\tx10800\tx11520\tx12240\tx12960\tx13680\tx14400\tx15120\tx15840\tx16560\tx17280\plain\f2\fs20\i{\txfielddef{\*\txfieldstart\txfieldtype3\txfieldflags0}{\*\txfielddatadef\txfielddatatype3\txfielddata 00030001}{\*\txfieldtext 1{\*\txfieldend}}{\field{\*\fldinst{ PAGE \\* Arabic }}{\fldrslt{1}}}}\plain\f2\fs20\i  - BAS Perkara Nomor #0001#\par}\pard\itap0\widctlpar\qc\sl360\slmult1\plain\f2\fs24\b BERITA ACARA SIDANG\par\plain\f2\fs24 Nomor #0001#\par Sidang Ikrar Talak\par\plain\f2\fs24\cf1\par\pard\itap0\widctlpar\qj\fi850\sl360\slmult1\plain\f2\fs24 #8008# yang memeriksa dan mengadili perkara tertentu pada tingkat pertama yang dilangsungkan di \plain\f3\fs24 #1261#\plain\f2\fs24 , pada hari \plain\f2\fs24\b #0032#\plain\f2\fs24  tanggal \plain\f2\fs24\b #0033# \plain\f2\fs24 dalam perkara #0048# antara:\par\pard\itap0\widctlpar\qj\fi-2551\li3401\sl360\slmult1\tx3140\tx3401\plain\f2\fs24\b #0098#\plain\f2\fs24 , tempat dan tanggal lahir #0341#, #0345#, agama #0011#, pendidikan #0021#, pekerjaan #0100#, tempat kediaman di #3517# sebagai #0046#;\par\pard\itap0\widctlpar\qc\fi-1701\li1701\sl360\slmult1\tx1701 melawan\par\pard\itap0\widctlpar\qj\fi-2551\li3401\sl360\slmult1\tx3128\tx3401\plain\f2\fs24\b #0102#\plain\f2\fs24 , tempat dan tanggal lahir #0343#, #0347#, agama #0020#, pendidikan #0024#, pekerjaan #0104#, #0124# #3518#, sebagai #0047#;\par\pard\itap0\keep\keepn\widctlpar\qj\sl360\slmult1\tx2126\plain\f3\fs24 Susunan majelis yang bersidang:\par\pard\itap0\keep\keepn\widctlpar\sl360\slmult1\tx426\tx4536 1.\tab #0012# \tab sebagai Ketua Majelis;\par 2.\tab #0013# \tab sebagai Hakim Anggota;\par 3.\tab #0014# \tab sebagai Hakim Anggota; dan dibantu\par\tab #0015# \tab sebagai #6034#.\par\pard\itap0\widctlpar\qj\fi850\sl360\slmult1\plain\f2\fs24 Setelah Ketua Majelis menyatakan sidang dibuka dan terbuka untuk umum, Pemohon dan Termohon dipanggil menghadap di  persidangan;\par #4046# tidak datang menghadap di persidangan dan tidak pula mengirim wakilnya yang sah, meskipun menurut relaas Nomor #0001#, tanggal #0118# yang dibacakan di persidangan, #4046# telah dipanggil secara resmi dan patut, dan ketidakdatangannya tersebut tidak disebabkan oleh suatu alasan yang sah;\par\pard\itap0\widctlpar\qj\fi850\sl360\slmult1\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080 #4047# juga tidak datang menghadap di persidangan dan tidak pula mengirim wakilnya, meskipun menurut relaas Nomor #0001#, tanggal #0120# yang dibacakan di persidangan, #4047# telah dipanggil secara resmi dan patut;\par\pard\itap0\widctlpar\qj\fi850\sl360\slmult1 Oleh karena #4046# tidak datang menghadap untuk mengucapkan ikrar talak, maka sidang ditunda dan akan dibuka kembali apabila #4046# datang melapor untuk mengucapkan ikrar talak dalam tenggang waktu 6 (enam) bulan sejak ditetapkannya hari sidang penyaksian ikrar talak, yaitu paling lambat pada hari #9217# tanggal #9216#, dengan ketentuan apabila dalam tenggang waktu tersebut #4046# tidak datang menghadap sendiri atau tidak mengirim wakilnya, maka gugurlah kekuatan putusan tersebut sesuai Pasal 70 ayat (6) Undang-Undang Nomor 7 Tahun 1989 tentang Peradilan Agama. Selanjutnya Ketua Majelis menyatakan sidang untuk perkara ini ditutup;\par Demikian berita acara sidang ini dibuat dan ditandatangani oleh Ketua Majelis serta #6034#.\par\pard\itap0\widctlpar\qj\fi616\sl360\slmult1\par\trowd\irow0\irowband0\lastrow\trgaph108\trrh388\trleft0\trftsWidth1\trftsWidthB3\trftsWidthA3\trpaddl108\trpaddr108\trpaddfl3\trpaddft3\trpaddfr3\trpaddfb3\clvertalt\clftsWidth3\clwWidth4389\cellx4389\clvertalt\clftsWidth3\clwWidth4377\cellx8766\pard\intbl\widctlpar\qc\sl360\slmult1 #6034#,\par\par\par\par\plain\f2\fs24\b #6033#\cell\plain\f2\fs24 Ketua Majelis,\par\par\par\par\plain\f2\fs24\b #0012#\cell\trowd\irow0\irowband0\lastrow\trgaph108\trrh388\trleft0\trftsWidth1\trftsWidthB3\trftsWidthA3\trpaddl108\trpaddr108\trpaddfl3\trpaddft3\trpaddfr3\trpaddfb3\clvertalt\clftsWidth3\clwWidth4389\cellx4389\clvertalt\clftsWidth3\clwWidth4377\cellx8766\row\pard\itap0\widctlpar\sl360\slmult1\par }