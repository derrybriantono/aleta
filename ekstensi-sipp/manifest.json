{
  "manifest_version": 3,
  "name": "ALETA E-Court",
  "version": "1.205.19",
  "update_url": "http://192.168.10.10/aleta/api/aleta-ecourt/ekstensi/updates.xml",
  "description": "Menempelkan keterangan ALETA ke halaman SIPP - batas waktu e-Court, tahapan perkara, kesiapan sidang, kelengkapan berkas - dan mengisikan usulan penunjukan serta Data Umum ke borangnya. Di halaman ALETA sendiri, panelnya menunjukkan versi, kewenangan, pintasan jabatan, dan jalan kembali ke perkara yang dibuka di SIPP. Tombol Simpan tetap ditekan petugas.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "http://192.168.10.10/*",
    "http://192.168.10.10:8008/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "ikon/aleta-16.png",
    "32": "ikon/aleta-32.png",
    "48": "ikon/aleta-48.png",
    "128": "ikon/aleta-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ALETA E-Court",
    "default_icon": {
      "16": "ikon/aleta-16.png",
      "32": "ikon/aleta-32.png",
      "48": "ikon/aleta-48.png",
      "128": "ikon/aleta-128.png"
    }
  },
  "background": {
    "service_worker": "latar.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://192.168.10.10/SIPP/*",
        "http://192.168.10.10/aps_badilag/*",
        "http://127.0.0.1/index.php/*",
        "http://127.0.0.1/aps_badilag/*"
      ],
      "js": [
        "penjaga-tanda.js",
        "tema-awal.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://192.168.10.10/SIPP/*",
        "http://127.0.0.1/index.php/*"
      ],
      "js": [
        "deteksi-sisa-blangko.js",
        "panel-alat.js",
        "jurusita.js",
        "basmassal.js",
        "saksiscan.js",
        "penunjukan-statistik.js",
        "konten.js",
        "checklist.js",
        "sipp-ide-l1.js",
        "sipp-ide-l2.js",
        "sipp-ide-m1.js",
        "sipp-ide-m2.js",
        "penetapan-borang.js",
        "penetapan-kerja.js",
        "muat-ulang-sipp.js",
        "penetapan-sipp.js",
        "abt-klien.js",
        "putusan-edoc-sekaligus.js",
        "putusan-sipp.js"
      ],
      "css": [
        "panel.css",
        "penetapan-sipp.css",
        "putusan-sipp.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://192.168.10.10/SIPP/*",
        "http://127.0.0.1/index.php/*"
      ],
      "js": [
        "jembatan.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://192.168.10.10/aps_badilag/*",
        "http://127.0.0.1/aps_badilag/*"
      ],
      "js": [
        "deteksi-sisa-blangko.js",
        "panel-alat.js",
        "jurusita.js",
        "basmassal.js",
        "saksi-katalog.js",
        "saksi-katalog-data.js",
        "saksi-susun.js",
        "isi-sipp-bersama.js",
        "abt.js",
        "checklist.js",
        "abt-klien.js",
        "blangko-derry.js",
        "blangko-derry-saksi.js",
        "blangko-derry-saksi-tampil.js",
        "blangko-derry-katalog.js",
        "blangko-derry-jawab-katalog.js",
        "blangko-derry-isian.js",
        "blangko-derry-massal.js",
        "konseptor-langkah.js",
        "putusan-advance.js",
        "sipp-ide-l1.js",
        "abt-gulir.js"
      ],
      "css": [
        "panel.css",
        "blangko-derry.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://192.168.10.10/aleta/*",
        "http://127.0.0.1/aleta/*"
      ],
      "js": [
        "deteksi-sisa-blangko.js",
        "panel-alat.js",
        "aleta.js",
        "checklist.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://192.168.10.10/SIPP/*",
        "http://192.168.10.10/aps_badilag/*",
        "http://192.168.10.10/aleta/*",
        "http://127.0.0.1/index.php/*",
        "http://127.0.0.1/aps_badilag/*",
        "http://127.0.0.1/aleta/*"
      ],
      "js": [
        "unduh-universal.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://192.168.10.10/SIPP/*",
        "http://192.168.10.10/aps_badilag/*",
        "http://192.168.10.10/aleta/*",
        "http://127.0.0.1/index.php/*",
        "http://127.0.0.1/aps_badilag/*",
        "http://127.0.0.1/aleta/*"
      ],
      "js": [
        "unduh-halaman.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ikon/aleta-32.png",
        "ikon/aleta-128.png"
      ],
      "matches": [
        "http://192.168.10.10/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
